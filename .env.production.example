# ============================================================================
# AllCombiner — Production environment variables
# ============================================================================
# Copy this file to `.env` on the production server and fill in real values.
# NEVER commit the real .env file to git.
# ============================================================================

# --- App ---
# Public URL of the site (used for SEO, OG tags, sitemap, absolute links)
NEXT_PUBLIC_APP_URL=https://www.allcombiner.com

# --- Database ---
# MySQL (production — via Hostinger phpMyAdmin)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# On Hostinger shared hosting, HOST is "localhost"
# ⚠️ URL-encode special chars in password: @ → %40, # → %23, etc.
# ⚠️ NEVER put the real password here — this file is tracked by git!
#     Put the real DATABASE_URL only in Hostinger's env vars (hPanel).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"
# SQLite (local dev only — NOT for production):
# DATABASE_URL="file:./prod.db"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_CHAR_STRING"
AUTH_TRUST_HOST=true

# --- Admin seed (used only by `npm run db:seed`) ---
ADMIN_EMAIL=admin@allcombiner.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_NAME=Admin

# --- OpenRouter (server-side ONLY — never exposed to client) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_SITE_URL=https://www.allcombiner.com
OPENROUTER_APP_NAME=AllCombiner

# --- Rate limiting (in-memory, per-IP) ---
RATE_LIMIT_FUSION_PER_HOUR=10
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_AUTH_PER_HOUR=20

# --- File upload limits ---
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_DIMENSION=4096

# --- Email (server-side ONLY — never exposed to client) ---
# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@allcombiner.com

# --- Server (optional — defaults to 3000) ---
PORT=3000
HOST=0.0.0.0
