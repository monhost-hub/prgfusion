// AllCombiner Prisma schema
// NOTE: This sandbox uses SQLite for fast local testing. The schema is portable to PostgreSQL:
//   1. Change `provider = "sqlite"` to `provider = "postgresql"`
//   2. Update DATABASE_URL in .env to a postgres:// URL
//   3. Run `bun run db:push`
// All column types below are SQLite-compatible but map cleanly to Postgres types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH (NextAuth.js v4 - credentials provider, JWT sessions)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  // Hashed with bcrypt. Never store plaintext.
  passwordHash  String
  // "USER" | "ADMIN"
  role          String    @default("USER")
  // Credit balance — debited on each fusion based on the model's creditCost.
  // Seeded to 3 on signup (free tier). Top-ups via recharges/subscriptions.
  credits       Int       @default(3)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  generations   Generation[]
  creditTxns    CreditTransaction[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// AI MODELS (configurable from admin — never hardcoded in fusion logic)
// ============================================================================

model AIModel {
  id          String   @id @default(cuid())
  // Display name shown in admin & UI, e.g. "Nano Banana 2 Lite"
  name        String
  // OpenRouter model id, e.g. "google/nano-banana-2-lite"
  providerId  String
  // "openrouter" (extensible to other providers)
  provider    String   @default("openrouter")
  // Short marketing description
  description String?
  // Approximate cost per generation in USD (informational)
  costPerCall Float    @default(0)
  // How many USER credits each fusion with this model costs.
  // Lite = 1, Banana 2 = 2, Pro = 3 (set by admin, editable from UI).
  creditCost  Int      @default(1)
  // Whether the model is selectable by users in the fusion UI.
  enabled     Boolean  @default(true)
  // Whether this is the default model selected in the UI (only one at a time).
  isActive    Boolean  @default(false)
  // Optional capability flags
  supportsImages Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  generations Generation[]

  @@index([provider])
  @@index([isActive])
}

// ============================================================================
// GENERATIONS (audit log of every fusion run)
// ============================================================================

model Generation {
  id          String   @id @default(cuid())
  userId      String
  modelId     String

  // "pending" | "running" | "succeeded" | "failed"
  status      String   @default("pending")
  // The full prompt sent to the model (for audit / reproducibility)
  prompt      String
  // Path under /public/uploads or data URL of input A
  inputAPath  String
  inputBPath  String
  // Output image URL or data URL
  outputPath  String?
  // ms
  durationMs  Int?
  // sanitized error message (no stack traces)
  error       String?
  // estimated cost in USD (informational, from OpenRouter)
  estimatedCost Float  @default(0)
  // How many user credits were debited for this fusion
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model AIModel  @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// CREDIT TRANSACTIONS (audit log of every credit change)
// ============================================================================

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  // Positive = credit added (purchase), negative = credit spent (fusion)
  amount    Int
  // Balance AFTER the transaction was applied (for audit)
  balance   Int
  // "fusion" | "signup_bonus" | "recharge" | "subscription" | "admin_adjustment" | "refund"
  reason    String
  // Optional reference (e.g. generation id, plan slug)
  reference String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// SITE SETTINGS (key-value store for prompt, OpenRouter status, etc.)
// ============================================================================

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String
  // Optional description shown in admin
  description String?
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PRICING PLANS (DB-driven — admin can edit, no price hardcoded in frontend)
// ============================================================================

model PricingPlan {
  id          String   @id @default(cuid())
  // Internal slug, e.g. "sub_free", "sub_starter", "recharge_mini"
  slug        String   @unique
  // i18n: name is a JSON object like {"en":"Pro","fr":"Pro","es":"Pro"}
  nameJson    String
  description String
  priceMonthly Float
  priceYearly  Float
  currency    String   @default("EUR")
  credits     Int
  // Highlighted in the pricing table
  featured    Boolean  @default(false)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)

  // === Whop integration (only for sub_* plans; null for recharges/free) ===
  // Whop plan id, e.g. "plan_CfZL537w2pKOn"
  whopPlanId       String?
  // Optional checkout URL override (otherwise generated via Whop API)
  whopCheckoutUrl  String?
  // "monthly" | "yearly" | "one_time"
  billingPeriod    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  whopPayments    WhopPayment[]
  planChanges     PricingPlanChange[]
}

// ============================================================================
// WHOP EVENTS (idempotence — one row per Whop event id, UNIQUE constraint)
// ============================================================================

model WhopEvent {
  id            String   @id @default(cuid())
  // Whop's event id — used as idempotence key (UNIQUE)
  whopEventId   String   @unique
  // Event type: "payment.succeeded" | "payment.failed" | "membership.activated" | ...
  eventType     String
  // Whop payment id (if available in the event payload)
  whopPaymentId String?
  // Whop membership id (if available)
  whopMembershipId String?
  // AllCombiner user id (from metadata.userId, validated)
  userId        String?
  // Plan id (slug) — determined server-side from Whop plan_id
  planSlug      String?
  // "succeeded" | "failed" | "ignored" | "unknown_plan" | "no_user"
  status        String
  // Number of credits granted (0 if not granted)
  creditsGranted Int     @default(0)
  // Raw event payload (JSON string) for audit/debug
  rawPayload    String
  // Error message (if status != succeeded)
  error         String?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

// ============================================================================
// WHOP PAYMENTS (one row per payment — linked to user + plan)
// ============================================================================

model WhopPayment {
  id            String   @id @default(cuid())
  // Whop payment id (UNIQUE — prevents double-credit on retries)
  whopPaymentId String   @unique
  userId        String
  planId        String
  // Whop event that triggered this payment (for audit)
  whopEventId   String?
  // Amount + currency (from Whop, never trust client)
  amount        Float
  currency      String   @default("EUR")
  // Credits granted (from plan, never from client)
  credits       Int
  // "succeeded" | "failed" | "refunded"
  status        String
  // Whop subscription/membership id (for recurring billing)
  whopMembershipId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan PricingPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PRICING PLAN CHANGES (audit log of admin edits to plans)
// ============================================================================

model PricingPlanChange {
  id          String   @id @default(cuid())
  planId      String
  // Admin user id who made the change
  adminId     String
  // Field name that was changed (e.g. "priceMonthly", "whopPlanId")
  field       String
  // Previous value (stringified)
  oldValue    String?
  // New value (stringified)
  newValue    String?
  createdAt   DateTime @default(now())

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([adminId])
  @@index([createdAt])
}

// ============================================================================
// CONTACT MESSAGES (from /contact)
// ============================================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  // "new" | "read" | "archived"
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
