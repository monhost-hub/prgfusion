# ============================================================================
# AllCombiner - Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- App ---
# Public URL of the site (used for SEO, OG tags, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# MySQL (recommended for production — Hostinger phpMyAdmin):
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# On Hostinger shared hosting, HOST is usually "localhost"
DATABASE_URL="mysql://u576014855_allcombiner:PASSWORD@localhost:3306/u576014855_allcombiner"
# SQLite (local dev only — NOT recommended for production):
# DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Comma-separated list of allowed origins for CSRF checks
AUTH_TRUST_HOST=true

# --- Admin seed ---
# Used by `bun run db:seed` to create the initial admin user
ADMIN_EMAIL=admin@allcombiner.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Admin

# --- OpenRouter (server-side ONLY — never exposed to client) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: site URL shown in OpenRouter dashboard rankings
OPENROUTER_SITE_URL=https://www.allcombiner.com
# Optional: app name shown in OpenRouter dashboard rankings
OPENROUTER_APP_NAME=AllCombiner

# --- Whop payments (server-side ONLY — never exposed to client) ---
# Get them at https://whop.com/dashboard/settings/developers
WHOP_COMPANY_API_KEY=
WHOP_WEBHOOK_SECRET=
# Default Plan IDs (used only by the seed — admin can change them later from /admin/payments)
WHOP_STARTER_PLAN_ID=plan_CfZL537w2pKOn
WHOP_CREATOR_PLAN_ID=plan_ljP4MuzoKR235
WHOP_PRO_PLAN_ID=plan_iZlkOxrRs9OHY
WHOP_BUSINESS_PLAN_ID=plan_Gk5R2N2OViuiK

# --- Rate limiting (in-memory, per-IP) ---
RATE_LIMIT_FUSION_PER_HOUR=10
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_AUTH_PER_HOUR=20

# --- File upload limits ---
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_DIMENSION=4096

# --- Email (server-side ONLY — never exposed to client) ---
# Resend API key — get one at https://resend.com/api-keys
# If empty, emails are logged to console (dev mode) instead of being sent.
RESEND_API_KEY=
# From address for all outgoing emails (must be a verified domain in Resend)
EMAIL_FROM=noreply@allcombiner.com
